<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="EggTimer">
  <grid id="27dc6" binding="panel1" default-binding="true" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="etched" title="Egg Timer" title-justification="2" title-position="2"/>
    <children>
      <grid id="16140" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="f86ef" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Elije el tipo de cocinado:"/>
            </properties>
          </component>
          <grid id="e7ecf" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="84485" class="javax.swing.JButton" binding="huevoDuroButton" default-binding="true">
                <constraints/>
                <properties>
                  <text value="Huevo Duro"/>
                </properties>
              </component>
              <component id="435d8" class="javax.swing.JButton" binding="medioCocidoButton" default-binding="true">
                <constraints/>
                <properties>
                  <text value="Medio Cocido"/>
                </properties>
              </component>
              <component id="9ad00" class="javax.swing.JButton" binding="pasadoPorAguaButton" default-binding="true">
                <constraints/>
                <properties>
                  <text value="Pasado por agua"/>
                </properties>
              </component>
            </children>
          </grid>
          <component id="a19c" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="¿Listo para empezar?"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="f0c26" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="6a14" class="javax.swing.JButton" binding="STOPButton" default-binding="true">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="STOP!"/>
            </properties>
          </component>
          <component id="bf6b1" class="javax.swing.JButton" binding="GOOButton" default-binding="true">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="GOO!!"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="a1b68" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="99682" class="javax.swing.JLabel" binding="labelTemporizador">
